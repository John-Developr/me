# Copy to .env (or .env.local) and fill in values. Never commit real secrets.

# Public site URL — used for canonical URLs, Open Graph, and sitemap
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase (blog storage — table: ai_blogs; admin dashboard data + auth)
# The anon key is used for admin sign-in and admin reads, so RLS applies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_SECRET_SUPABASE_ROLE_KEY=

# Media Library storage limit shown in the admin, in MB (default 1024 = Supabase Free plan's 1 GB).
# Uploads are refused once the "media" bucket reaches it. Pro plan: e.g. 102400 (100 GB).
MEDIA_STORAGE_LIMIT_MB=

# First-party analytics (no cookies, no IPs stored). Set ANALYTICS_DISABLED=1 to turn it off;
# ANALYTICS_DEV=1 also records visits from `npm run dev` (off by default: dev uses the live database).
ANALYTICS_DISABLED=
ANALYTICS_DEV=

# Google Gemini (chat assistant + blog generation)
# KEY2 is optional: used automatically when KEY hits its usage limit or is unavailable.
NEXT_SECRET_GEMINI_API_KEY=
NEXT_SECRET_GEMINI_API_KEY2=

# Gmail SMTP (contact form, via Nodemailer — use a Gmail App Password)
GMAIL_USER_EMAIL=
GMAIL_APP_PASSWORD=

# Vercel Cron — bearer token checked by /api/cron/blog
CRON_SECRET=
